{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dzgreeno.github.io/AssetRipper-DzGreen/schemas/premium-import-diagnostics.schema.json",
  "title": "AssetRipper DzGreen Premium Import Diagnostics",
  "type": "object",
  "required": ["diagnostics", "verifiedOnly"],
  "properties": {
    "diagnostics": {
      "type": "object",
      "required": ["unityVersion", "inputs", "assetCollectionCount", "resourceFileCount", "failedFileCount", "assetClasses", "importStatus"],
      "properties": {
        "unityVersion": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "object", "required": ["path", "isDirectory", "exists"], "properties": { "path": { "type": "string" }, "isDirectory": { "type": "boolean" }, "exists": { "type": "boolean" } } } },
        "assetCollectionCount": { "type": "integer", "minimum": 0 },
        "resourceFileCount": { "type": "integer", "minimum": 0 },
        "failedFileCount": { "type": "integer", "minimum": 0 },
        "assetClasses": { "type": "array", "items": { "type": "object", "required": ["className", "count", "isRecoveryPriority"], "properties": { "className": { "type": "string" }, "count": { "type": "integer", "minimum": 0 }, "isRecoveryPriority": { "type": "boolean" } } } },
        "importStatus": { "type": "string" }
      },
      "additionalProperties": true
    },
    "verifiedOnly": { "type": "object", "additionalProperties": true },
    "fallbackTextures": { "type": ["object", "null"], "additionalProperties": true }
  },
  "additionalProperties": false
}
